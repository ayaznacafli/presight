# Only needed when the API is NOT reachable at the same origin under /api/v1.
# Left unset, the client uses the relative path (Vite proxy in dev, nginx in Docker).
# VITE_API_BASE_URL=http://localhost:4000/api/v1

# Where `npm run dev` proxies /api during local development.
VITE_API_PROXY_TARGET=http://localhost:4000
