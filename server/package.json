{
  "name": "presight-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "db:migrate": "node src/db/cli/migrate.ts",
    "db:seed": "node src/db/cli/seed.ts",
    "db:reset": "node src/db/cli/seed.ts --fresh",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "~11.0.1",
    "@fastify/helmet": "~13.0.1",
    "@fastify/swagger": "~9.4.2",
    "@fastify/swagger-ui": "~5.2.1",
    "fastify": "~5.2.1",
    "fastify-plugin": "~5.0.1",
    "zod": "~4.0.5"
  },
  "devDependencies": {
    "@types/node": "~22.13.1",
    "pino-pretty": "~13.0.0",
    "typescript": "~5.7.3"
  }
}
