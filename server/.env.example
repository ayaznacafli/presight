# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# SQLite file used as the source of truth
DATABASE_PATH=./data/presight.sqlite

# Comma-separated allowed origins, or * for any
CORS_ORIGIN=*

# Seeding
SEED_USER_COUNT=25000
SEED_RANDOM_SEED=20260830

# Apply schema (and seed when empty) on boot
AUTO_MIGRATE=true
